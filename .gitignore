# Local build and editor files
/build/
**/build/
.cache/
.venv/
__pycache__/
*.pyc
.idea/
.vscode/
*.o
*.obj
*.exe
*.out
*.dSYM/

# Reproducible distribution output and local course material
/dist/
/references/local/
*.zip

# Course originals stay local; only the two authored report PDFs are allowed.
*.pdf
*.ppt
*.pptx
*.odp
/slides/
/materials/
/assignment-statements/

# Generated experiment/report outputs stay local.
/assignments/assignment1/results/*/
!/assignments/assignment1/results/figures/
!/assignments/assignment1/results/platforms/
!/assignments/assignment1/results/processed/
!/assignments/assignment1/results/raw/
/assignments/assignment1/results/figures/*
/assignments/assignment1/results/platforms/*
/assignments/assignment1/results/processed/*
/assignments/assignment1/results/raw/*
!/assignments/assignment1/results/*/.gitkeep
/assignments/assignment1/report/report.md
*.log

/results-local/
/validation-local/

# Ass2 course material, downloaded networks, and generated outputs
/assignments/assignment2/data/local/
/assignments/assignment2/results/*/
/assignments/assignment2/report/report.md
*.ipynb
*.osm
*.osm.bz2
*.graphml
/assignments/assignment2/report/figures/

# Authored English reports explicitly approved for publication
!/assignments/assignment1/report/Assignment1_Report_EN.pdf
!/assignments/assignment2/report/Assignment2_Report_EN.pdf
